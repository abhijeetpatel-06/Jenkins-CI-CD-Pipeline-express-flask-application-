pipeline {
    agent any

    environment {
        BACKEND_DIR = "${WORKSPACE}/backend"
        VENV_DIR = "${WORKSPACE}/backend/venv"
    }

    stages {

        stage('Install Dependencies') {
            steps {
                echo 'Creating Python virtual environment...'

                sh '''
                    cd "${BACKEND_DIR}"

                    echo "Python version:"
                    python3 --version

                    echo "Creating virtual environment..."
                    python3 -m venv "${VENV_DIR}"

                    echo "Upgrading pip..."
                    "${VENV_DIR}/bin/pip" install --upgrade pip

                    echo "Installing Flask dependencies..."
                    "${VENV_DIR}/bin/pip" install -r requirements.txt

                    echo "Dependencies installed successfully."
                '''
            }
        }

        stage('Restart Application') {
            steps {
                echo 'Restarting Flask backend with PM2...'

                sh '''
                    cd "${BACKEND_DIR}"

                    echo "Checking PM2..."
                    pm2 --version

                    echo "Restarting Flask backend..."

                    pm2 restart flask-backend || \
                    pm2 start app.py \
                        --name flask-backend \
                        --interpreter "${VENV_DIR}/bin/python"

                    pm2 save

                    echo "Current PM2 processes:"
                    pm2 list
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Flask backend deployed successfully!'
        }

        failure {
            echo '❌ Flask backend deployment failed. Check the console output above.'
        }
    }
}